# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# WhatsApp Embedded Signup (Coexistence) - optional, lets a restaurant connect
# its existing WhatsApp Business app number from /admin/whatsapp instead of
# the WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID above. Requires a Meta
# Tech Provider / Solution Partner app - get these from that app's Meta
# Developer Console once approved.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# OpenRouter (LLM provider)
# From openrouter.ai/keys
OPENROUTER_API_KEY=
# Any chat model available on OpenRouter, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4.1, etc.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Comma-separated fallback chain tried in order if OPENROUTER_MODEL fails
# (rate limit, provider outage, timeout) - spread across different free-tier
# providers plus one cheap paid model as a last resort.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,thinkingmachines/inkling-small:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,~google/gemini-flash-latest

# Voice transcription (Groq's Whisper-compatible endpoint by default)
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3

# Admin dashboard session auth - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=

# Thermal printer integration (optional, can be connected later) - shared
# secret for the restaurant's local print agent (print_agent/agent.py).
PRINT_AGENT_TOKEN=

# Restaurant info
STORE_NAME=Fine Dine Family Restaurant
STORE_PHONE=
STORE_LAT=
STORE_LNG=
STORE_TIMEZONE=UTC
# Operating hours (24h local time, STORE_TIMEZONE) - orders are accepted
# from STORE_OPEN_HOUR up to STORE_ORDER_CUTOFF_MINUTES before
# STORE_CLOSE_HOUR. A close hour <= open hour is treated as past midnight
# (e.g. open 8, close 2 -> 8:00 AM to 2:00 AM, last orders 1:30 AM).
STORE_OPEN_HOUR=8
STORE_CLOSE_HOUR=2
STORE_ORDER_CUTOFF_MINUTES=30

# Delivery pricing
DELIVERY_FEE=5
FREE_DELIVERY_THRESHOLD=50
CURRENCY=AED

PORT=8000
